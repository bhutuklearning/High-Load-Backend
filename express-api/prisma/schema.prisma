generator client {
  provider = "prisma-client-js"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  created_at DateTime @default(now())

  @@map("users")
}

model Document {
  id           String   @id @default(uuid())
  title        String
  content      String
  summary      String?
  keywords     Json?
  sentiment    String?
  reading_time Int?
  status       String   @default("pending")
  created_at   DateTime @default(now())

  @@map("documents")
}
